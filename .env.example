# Postgres connection string (Neon via the Vercel Storage tab injects DATABASE_URL automatically)
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Long random string. Signs OAuth state and encrypts stored Google tokens.
AUTH_SECRET=change-me-to-a-long-random-string

# Anyone creating an account must type this. Leave empty to allow open registration.
INVITE_CODE=

# Google Calendar integration (Google Cloud console > APIs & Services > Credentials > OAuth client, type "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public origin of the deployed app, used to build the OAuth redirect URI. Optional: defaults to the request host.
APP_URL=
